# SBTS Production Database Persistence
# MySQL-compatible database URL used by Drizzle ORM.
# Example:
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/SBTS_DB
DATABASE_URL=

# Server
PORT=3000
NODE_ENV=development

# Optional future production settings
SBTS_ENVIRONMENT=production-bound
SBTS_FILE_STORAGE=database-preview

# Sprint 12 auth/session settings
SBTS_AUTH_MODE=password
SBTS_SESSION_HOURS=12
SBTS_PASSWORD_MIN_LENGTH=10
