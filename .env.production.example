# SBTS Sprint 16 — Online Deployment / Production Environment
NODE_ENV=production
PORT=3000
SBTS_APP_VERSION=16.0.0

# Public URL used for cookies/CORS and generated links
APP_PUBLIC_URL=https://your-sbts-domain.com
ALLOWED_ORIGIN=https://your-sbts-domain.com

# MySQL-compatible database used by Drizzle ORM
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/SBTS_DB

# Authentication / sessions
SBTS_AUTH_MODE=password
SBTS_SESSION_HOURS=12
SBTS_PASSWORD_MIN_LENGTH=10
COOKIE_SECURE=true

# First admin bootstrap. Set only during initial seed, then remove from hosting variables.
SBTS_ADMIN_EMPLOYEE_ID=admin-001
SBTS_ADMIN_BADGE=admin
SBTS_ADMIN_NAME=System Admin
SBTS_ADMIN_USERNAME=admin
SBTS_ADMIN_EMAIL=admin@example.com
SBTS_ADMIN_PASSWORD=ChangeMe2026!

# Optional storage mode; Data URL fallback remains available for pilot.
SBTS_FILE_STORAGE=database-preview
